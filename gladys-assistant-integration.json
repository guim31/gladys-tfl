{
  "manifest_version": 1,
  "type": "device",
  "name": "Transport for London",
  "description": {
    "en": "London Tube, Overground, DLR, Elizabeth line, tram and bus: line status and next arrivals.",
    "fr": "Métro, Overground, DLR, Elizabeth line, tram et bus de Londres : état des lignes, prochains passages",
    "de": "Londoner U-Bahn, Overground, DLR, Elizabeth line, Tram und Bus: Linienstatus und nächste Ankünfte.",
    "es": "Metro, Overground, DLR, Elizabeth line, tranvía y autobús de Londres: estado y próximas llegadas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-tfl:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-tfl/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Comment ça marche",
        "de": "So funktioniert es",
        "es": "Cómo funciona"
      },
      "description": {
        "en": "Follow lines and watch stops with the actions below, then create their devices in the Discover tab. Everything comes from TfL open data: no account needed, the key is optional.",
        "fr": "Suivez des lignes et des arrêts avec les actions ci-dessous, puis créez leurs appareils dans l'onglet Découverte. Tout vient de l'open data de TfL : pas de compte, la clé est facultative.",
        "de": "Verfolge Linien und Haltestellen mit den Aktionen unten und lege dann ihre Geräte im Tab „Entdecken“ an. Alles stammt aus den Open Data von TfL: kein Konto nötig, der Schlüssel ist optional.",
        "es": "Siga líneas y paradas con las acciones de abajo y luego cree sus dispositivos en la pestaña Descubrir. Todo procede de los datos abiertos de TfL: sin cuenta, la clave es opcional."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-tfl/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Anleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://api-portal.tfl.gov.uk",
          "label": {
            "en": "TfL API portal (free key)",
            "fr": "Portail API TfL (clé gratuite)",
            "de": "TfL-API-Portal (kostenloser Schlüssel)",
            "es": "Portal API de TfL (clave gratuita)"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the feature names, of the statuses and of the sentences sent to your scenes. The reasons of the disruptions stay in English, as TfL writes them. Feature names are set when a device is created.",
        "fr": "Langue des noms de fonctionnalités, des états et des phrases envoyées à vos scènes. Les motifs des perturbations restent en anglais, tels que TfL les écrit. Les noms sont fixés à la création de l'appareil.",
        "de": "Sprache der Funktionsnamen, der Status und der Sätze für deine Szenen. Die Gründe der Störungen bleiben Englisch, wie TfL sie schreibt. Die Namen werden beim Anlegen des Geräts festgelegt.",
        "es": "Idioma de los nombres de funciones, de los estados y de las frases enviadas a sus escenas. Los motivos de las incidencias siguen en inglés, como los escribe TfL. Los nombres se fijan al crear el dispositivo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de mise à jour",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often TfL is read for your created devices: one status request, plus one request per stop point.",
        "fr": "Fréquence de lecture de TfL pour vos appareils créés : une requête d'état, plus une par point d'arrêt.",
        "de": "Wie oft TfL für deine angelegten Geräte gelesen wird: eine Statusanfrage plus eine pro Haltepunkt.",
        "es": "Frecuencia de lectura de TfL para sus dispositivos creados: una petición de estado y una por punto de parada."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        }
      ]
    },
    {
      "key": "app_key",
      "type": "secret",
      "label": {
        "en": "TfL app key (optional)",
        "fr": "Clé d'application TfL (facultative)",
        "de": "TfL-App-Schlüssel (optional)",
        "es": "Clave de aplicación de TfL (opcional)"
      },
      "description": {
        "en": "Free from the TfL API portal: it raises the quota to 500 requests a minute. Without it the integration works on the anonymous quota.",
        "fr": "Gratuite sur le portail API de TfL : elle porte le quota à 500 requêtes par minute. Sans elle, l'intégration fonctionne avec le quota anonyme.",
        "de": "Kostenlos im TfL-API-Portal: Er hebt das Kontingent auf 500 Anfragen pro Minute. Ohne ihn läuft die Integration mit dem anonymen Kontingent.",
        "es": "Gratuita en el portal API de TfL: eleva la cuota a 500 peticiones por minuto. Sin ella, la integración funciona con la cuota anónima."
      },
      "required": false
    }
  ],
  "actions": [
    {
      "key": "add_line",
      "label": {
        "en": "Follow a line",
        "fr": "Suivre une ligne",
        "de": "Linie verfolgen",
        "es": "Seguir una línea"
      },
      "description": {
        "en": "Adds a line (Tube, Overground, DLR, Elizabeth line, tram or bus) to the Discover tab.",
        "fr": "Ajoute une ligne (métro, Overground, DLR, Elizabeth line, tram ou bus) à l'onglet Découverte.",
        "de": "Fügt eine Linie (U-Bahn, Overground, DLR, Elizabeth line, Tram oder Bus) dem Tab „Entdecken“ hinzu.",
        "es": "Añade una línea (metro, Overground, DLR, Elizabeth line, tranvía o autobús) a la pestaña Descubrir."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "line",
          "type": "string",
          "required": true,
          "label": {
            "en": "Line name or number",
            "fr": "Nom ou numéro de la ligne",
            "de": "Name oder Nummer der Linie",
            "es": "Nombre o número de la línea"
          },
          "placeholder": {
            "en": "e.g. Victoria, Elizabeth line, 73",
            "fr": "ex. Victoria, Elizabeth line, 73",
            "de": "z. B. Victoria, Elizabeth line, 73",
            "es": "p. ej. Victoria, Elizabeth line, 73"
          }
        }
      ]
    },
    {
      "key": "remove_line",
      "label": {
        "en": "Stop following a line",
        "fr": "Ne plus suivre une ligne",
        "de": "Linie nicht mehr verfolgen",
        "es": "Dejar de seguir una línea"
      },
      "description": {
        "en": "Removes a followed line. Its device stays in Gladys until you delete it.",
        "fr": "Retire une ligne suivie. Son appareil reste dans Gladys jusqu'à ce que vous le supprimiez.",
        "de": "Entfernt eine verfolgte Linie. Das Gerät bleibt in Gladys, bis du es löschst.",
        "es": "Elimina una línea seguida. Su dispositivo permanece en Gladys hasta que lo borre."
      },
      "fields": [
        {
          "key": "line",
          "type": "string",
          "required": true,
          "label": {
            "en": "Line",
            "fr": "Ligne",
            "de": "Linie",
            "es": "Línea"
          },
          "placeholder": {
            "en": "e.g. Victoria",
            "fr": "ex. Victoria",
            "de": "z. B. Victoria",
            "es": "p. ej. Victoria"
          }
        }
      ]
    },
    {
      "key": "search_stops",
      "label": {
        "en": "Find a stop",
        "fr": "Chercher un arrêt",
        "de": "Haltestelle suchen",
        "es": "Buscar una parada"
      },
      "description": {
        "en": "Lists the stations and bus stops matching a name, with their identifier.",
        "fr": "Liste les stations et arrêts de bus qui correspondent à un nom, avec leur identifiant.",
        "de": "Listet die Stationen und Bushaltestellen zu einem Namen mit ihrer Kennung auf.",
        "es": "Muestra las estaciones y paradas de autobús que coinciden con un nombre, con su identificador."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": true,
          "label": {
            "en": "Stop or station name",
            "fr": "Nom de l'arrêt ou de la station",
            "de": "Name der Haltestelle oder Station",
            "es": "Nombre de la parada o estación"
          },
          "placeholder": {
            "en": "e.g. Oxford Circus",
            "fr": "ex. Oxford Circus",
            "de": "z. B. Oxford Circus",
            "es": "p. ej. Oxford Circus"
          }
        }
      ]
    },
    {
      "key": "add_stop",
      "label": {
        "en": "Add a stop",
        "fr": "Ajouter un arrêt",
        "de": "Haltestelle hinzufügen",
        "es": "Añadir una parada"
      },
      "description": {
        "en": "Watches the arrivals of a station or bus stop, with an optional line and direction filter.",
        "fr": "Suit les passages d'une station ou d'un arrêt de bus, avec un filtre facultatif de ligne et de direction.",
        "de": "Verfolgt die Ankünfte einer Station oder Bushaltestelle, optional gefiltert nach Linie und Richtung.",
        "es": "Sigue las llegadas de una estación o parada de autobús, con un filtro opcional de línea y dirección."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "stop",
          "type": "string",
          "required": true,
          "label": {
            "en": "Stop name or identifier",
            "fr": "Nom ou identifiant de l'arrêt",
            "de": "Name oder Kennung der Haltestelle",
            "es": "Nombre o identificador de la parada"
          },
          "placeholder": {
            "en": "e.g. Oxford Circus or 940GZZLUOXC",
            "fr": "ex. Oxford Circus ou 940GZZLUOXC",
            "de": "z. B. Oxford Circus oder 940GZZLUOXC",
            "es": "p. ej. Oxford Circus o 940GZZLUOXC"
          }
        },
        {
          "key": "lines",
          "type": "string",
          "required": false,
          "label": {
            "en": "Lines (empty: all)",
            "fr": "Lignes (vide : toutes)",
            "de": "Linien (leer: alle)",
            "es": "Líneas (vacío: todas)"
          },
          "description": {
            "en": "Separated by commas.",
            "fr": "Séparées par des virgules.",
            "de": "Durch Kommas getrennt.",
            "es": "Separadas por comas."
          },
          "placeholder": {
            "en": "e.g. Victoria, Central",
            "fr": "ex. Victoria, Central",
            "de": "z. B. Victoria, Central",
            "es": "p. ej. Victoria, Central"
          }
        },
        {
          "key": "direction",
          "type": "string",
          "required": false,
          "label": {
            "en": "Direction (empty: all)",
            "fr": "Direction (vide : toutes)",
            "de": "Richtung (leer: alle)",
            "es": "Dirección (vacío: todas)"
          },
          "description": {
            "en": "Part of the destination or of the platform: Brixton, Southbound…",
            "fr": "Partie de la destination ou du quai : Brixton, Southbound…",
            "de": "Teil des Ziels oder des Bahnsteigs: Brixton, Southbound…",
            "es": "Parte del destino o del andén: Brixton, Southbound…"
          },
          "placeholder": {
            "en": "e.g. Southbound",
            "fr": "ex. Southbound",
            "de": "z. B. Southbound",
            "es": "p. ej. Southbound"
          }
        }
      ]
    },
    {
      "key": "remove_stop",
      "label": {
        "en": "Remove a stop",
        "fr": "Retirer un arrêt",
        "de": "Haltestelle entfernen",
        "es": "Eliminar una parada"
      },
      "description": {
        "en": "Stops watching a stop. Its device stays in Gladys until you delete it.",
        "fr": "Arrête de suivre un arrêt. Son appareil reste dans Gladys jusqu'à ce que vous le supprimiez.",
        "de": "Beendet das Verfolgen einer Haltestelle. Das Gerät bleibt in Gladys, bis du es löschst.",
        "es": "Deja de seguir una parada. Su dispositivo permanece en Gladys hasta que lo borre."
      },
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name shown in the status",
            "fr": "Nom affiché dans l'état",
            "de": "Name aus dem Status",
            "es": "Nombre que aparece en el estado"
          },
          "placeholder": {
            "en": "e.g. Oxford Circus (Victoria)",
            "fr": "ex. Oxford Circus (Victoria)",
            "de": "z. B. Oxford Circus (Victoria)",
            "es": "p. ej. Oxford Circus (Victoria)"
          }
        }
      ]
    },
    {
      "key": "status",
      "label": {
        "en": "Status",
        "fr": "État",
        "de": "Status",
        "es": "Estado"
      },
      "description": {
        "en": "Lists the followed lines and watched stops, and the last read of TfL.",
        "fr": "Liste les lignes et arrêts suivis, et la dernière lecture de TfL.",
        "de": "Listet die verfolgten Linien und Haltestellen und das letzte Lesen von TfL auf.",
        "es": "Muestra las líneas y paradas seguidas, y la última lectura de TfL."
      }
    }
  ],
  "widgets": [
    {
      "key": "arrivals",
      "label": {
        "en": "Next arrivals",
        "fr": "Prochains passages",
        "de": "Nächste Ankünfte",
        "es": "Próximas llegadas"
      },
      "description": {
        "en": "The next arrivals of a stop, coloured by the status of their line.",
        "fr": "Les prochains passages d'un arrêt, colorés selon l'état de leur ligne.",
        "de": "Die nächsten Ankünfte einer Haltestelle, gefärbt nach dem Status ihrer Linie.",
        "es": "Las próximas llegadas de una parada, coloreadas según el estado de su línea."
      },
      "icon": "clock",
      "settings": [
        {
          "key": "stop",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Stop",
            "fr": "Arrêt",
            "de": "Haltestelle",
            "es": "Parada"
          }
        }
      ]
    },
    {
      "key": "line_status",
      "label": {
        "en": "TfL line status",
        "fr": "État des lignes TfL",
        "de": "Status der TfL-Linien",
        "es": "Estado de líneas TfL"
      },
      "description": {
        "en": "The status of every followed line, the worst first.",
        "fr": "L'état de chaque ligne suivie, la plus perturbée en premier.",
        "de": "Der Status jeder verfolgten Linie, die am stärksten gestörte zuerst.",
        "es": "El estado de cada línea seguida, la más afectada primero."
      },
      "icon": "activity"
    }
  ],
